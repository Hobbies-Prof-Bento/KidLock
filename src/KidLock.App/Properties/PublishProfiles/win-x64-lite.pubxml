<Project>
  <!-- Executável pequeno que usa o ".NET Desktop Runtime 8" já instalado no Windows. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64-lite\</PublishDir>
  </PropertyGroup>
</Project>
