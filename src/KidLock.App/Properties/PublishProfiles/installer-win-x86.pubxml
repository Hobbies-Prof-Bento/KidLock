<Project>
  <!--
    Conteúdo do instalador: pasta com o programa e TODO o runtime .NET (self-contained).
    x86 roda em qualquer Windows 10/11: 32 bits, 64 bits e ARM (por emulação, inclusive no Windows 10 ARM).
    Sem arquivo único: o instalador já comprime tudo e o programa abre mais rápido e usa menos memória.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\installer-win-x86\</PublishDir>
  </PropertyGroup>
</Project>
